import 'package:flutter/material.dart';

import '../../models/logic_block.dart';
import '../../models/project_model.dart';
import '../render_context.dart';
import 'block_types/show_snackbar_block.dart';
import 'block_types/navigate_block.dart';
import 'block_types/set_variable_block.dart';
import 'block_types/condition_block.dart';
import 'block_types/loop_block.dart';
import 'block_types/math_operation_block.dart';   // <-- Ajout

/// Exécuteur de blocs logiques pour le mode aperçu.
///
/// Prend en charge l'exécution séquentielle des blocs associés à un
/// événement. Il a besoin d'un [BuildContext] pour les SnackBars et la
/// navigation, d'un [RenderContext] pour les variables/références, et du
/// projet pour la navigation.
///
/// Les blocs imbriqués (if, loop) utilisent la méthode publique
/// [executeBlock] pour exécuter leurs enfants de manière récursive.
class LogicExecutor {
  final ProjectModel project;
  final RenderContext renderContext;
  final BuildContext buildContext;

  LogicExecutor({
    required this.project,
    required this.renderContext,
    required this.buildContext,
  });

  /// Exécute une liste de blocs séquentiellement.
  void execute(List<LogicBlock> blocks) {
    for (final block in blocks) {
      executeBlock(block);
    }
  }

  /// Exécute un seul bloc.
  /// Cette méthode est publique pour permettre aux blocs imbriqués
  /// (condition, boucle) de déléguer l'exécution de leurs sous-blocs.
  void executeBlock(LogicBlock block) {
    switch (block.type) {
      case LogicBlockTypes.showSnackbar:
        ShowSnackbarBlock.execute(block, buildContext);
        break;
      case LogicBlockTypes.navigateTo:
        NavigateBlock.execute(block, project, buildContext);
        break;
      case LogicBlockTypes.setVariable:
        SetVariableBlock.execute(block, renderContext);
        break;
      case LogicBlockTypes.ifBlock:
      case 'condition': // alias possible
        ConditionBlock.execute(block, this);
        break;
      case LogicBlockTypes.loopBlock:
        LoopBlock.execute(block, this);
        break;
      case LogicBlockTypes.mathOperation:   // <-- Nouveau case
        MathOperationBlock.execute(block, this);
        break;
      default:
        // Bloc non supporté en mode aperçu
        break;
    }
  }
}